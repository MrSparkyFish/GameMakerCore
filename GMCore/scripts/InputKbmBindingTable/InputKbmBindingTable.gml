//feather ignore all
/**
 * @return {} */
function InputKbmBindingTable() constructor {
	
	//Mouse
	self[$ mb_left] = mouse_check_button;
	self[$ mb_middle] = mouse_check_button;
	self[$ mb_right] = mouse_check_button;
	self[$ mb_side1] = mouse_check_button;
	self[$ mb_side2] = mouse_check_button;
	self[$ mb_wheel_down] = mouse_wheel_down;
	self[$ mb_wheel_up] = mouse_wheel_up;
	
	//Keyboard
	self[$ vk_backtick] = keyboard_check;
    self[$ vk_hyphen] = keyboard_check;
