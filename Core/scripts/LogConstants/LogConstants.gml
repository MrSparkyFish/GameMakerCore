//feather ignore all
 

#macro LOGGER_DEFAULT_ID "$$default_logger$$"						//Shortcut to get the default logger


#macro LOGGING_ENABLED 		true									//If false, all logging is disabled.
#macro LOG_INFO_ENABLED		true									//If false, all Into logging is disabled
#macro LOG_DEBUG_ENABLED	true									//If false, all debug logging is disabled
#macro LOG_WARNING_ENABLED	true									//If false, all warning logging is disabled
#macro LOG_ERROR_ENABLED	true									//If false, all error logging is disabled
#macro LOG_CRITICAL_ENABLED	true									//If false, all critical logging is disabled